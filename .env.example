# Browser-safe values from Supabase Project Settings → API.
# Never place a service_role key in this file or in a Vercel public variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: flight lookup in the journey form (server-side only, never NEXT_PUBLIC_).
# A key from AeroDataBox; set AERODATABOX_PROVIDER to "rapidapi" or "apimarket"
# when the key comes from one of those marketplaces (default: "direct").
AERODATABOX_API_KEY=
AERODATABOX_PROVIDER=direct
